# BugPulse AI Backend Environment Configuration Template

PROJECT_NAME="BugPulse AI Backend"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
DEBUG=true

# Security
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bugpulse_db"

# Redis Cache / Task Queue
REDIS_URL="redis://localhost:6379/0"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

