# BugPulse AI - Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# Backend REST API base URL
VITE_API_URL=http://localhost:8000/api/v1

# Real-time WebSocket connection URL for notifications and live scan updates
VITE_WS_URL=ws://localhost:8000/ws

# Application branding name
VITE_APP_NAME="BugPulse AI"

# Toggle fallback mock data when backend service is offline (true | false)
VITE_ENABLE_MOCK_DATA=true

# Standalone Mock API Layer for full offline authentication, profile & 2FA testing (true | false)
VITE_USE_MOCK=true

# Optional: GitHub OAuth Client ID for GitHub Sign-in integration
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here

